# ─────────────────────────────────────────────────────────────────────────
# ChatFat — environment template
#
#   cp .env.example .env
#   npm start
#
# `.env` is gitignored; this file is NOT, so it must never hold a real
# credential. Every value below is a placeholder.
#
# The real environment always wins over `.env`. Set ChatFat_ENV_FILE=off to
# skip reading `.env` entirely (the test suites do this).
# ─────────────────────────────────────────────────────────────────────────


# ── Network ──────────────────────────────────────────────────────────────

PORT=3000

# 0.0.0.0 accepts connections from other machines, which a LAN demo needs.
# 127.0.0.1 keeps it local to this machine only.
HOST=0.0.0.0

# Comma-separated origins allowed to open a WebSocket. Empty is the sensible
# default: a browser's Origin must match the host it dialled. Set this
# explicitly behind a proxy on a different name:
#   ALLOWED_ORIGINS=https://chat.example.edu,http://localhost:3000
ALLOWED_ORIGINS=


# ── Database — P1 ────────────────────────────────────────────────────────
#
# Three modes:
#
#   postgres://…  Durable. This is the deployed configuration.
#   memory        Everything works, held in this process, lost on restart.
#                 Used by the test suites and for offline development.
#   (empty)       Refuses to start once P1 lands — an unset DATABASE_URL
#                 used to mean "silently store nothing", which is the one
#                 behaviour the lab explicitly forbids.
#
# Neon (free, no card):
#   1. Sign up at https://neon.tech and create a project
#   2. Copy the POOLED connection string (the host contains "-pooler")
#   3. Keep ?sslmode=require — Neon refuses plaintext connections
#
# NOTE: the Neon free tier scales to zero after a few minutes idle, so the
# first query after a quiet spell pays ~500ms of cold start. Harmless in use,
# visible in a demo — hit /healthz before you start recording.
DATABASE_URL=


# ── At-rest encryption — P4 ──────────────────────────────────────────────
#
# 32 random bytes, base64. Generate with:
#   node tools/keygen.js
#
# Every message row is encrypted under a key derived from this before it
# reaches the database. LOSING THIS MAKES ALL STORED HISTORY UNREADABLE, and
# that is the intended behaviour — it is what makes a database dump useless.
# Back it up somewhere that is not this repo.
#
# Rotation: MASTER_KEYS takes a versioned list so old rows still open.
#   MASTER_KEYS=v1:<old-base64>,v2:<new-base64>
MASTER_KEY=REPLACE_ME_RUN_node_tools_keygen_js
# MASTER_KEYS=


# ── Identity: Better Auth, email + password — P3 ─────────────────────────
#
# Email and password rather than a social provider, deliberately. OAuth would
# have made a working demo depend on obtaining a domain name and a TLS
# certificate for the deployed host — Google refuses non-HTTPS redirect URIs
# for every origin but localhost — and none of that bears on any of the six
# things the lab actually grades. The cost is that we store password hashes
# again; Better Auth handles the hashing.
#
# Signing secret for sessions. 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=REPLACE_ME

# The public origin this server is reached at. Used to scope session cookies,
# so it must match the origin the browser actually dials.
BETTER_AUTH_URL=http://localhost:3000


# ── Messages ─────────────────────────────────────────────────────────────

# How many stored messages a joining client receives.
#
# Recording and replaying are separate questions: messages are written to the
# database regardless, and this governs only what is handed BACK to a client
# entering a room. 0 replays nothing.
HISTORY_REPLAY=50

# Per-room in-memory buffer. Bounds how far back a reaction, edit, reply or
# unsend can reach — not a window anyone can browse.
HISTORY_CAP=200

# Ceiling on rooms this server will host.
MAX_ROOMS=24


# ── Encryption (end-to-end, per room) ────────────────────────────────────

# Set to 0 to forbid locking rooms on this server.
ENCRYPTION_ENABLED=1

# Byte cap on one ciphertext envelope.
MAX_CIPHERTEXT=12288


# ── Storage ──────────────────────────────────────────────────────────────

# Only used when there is no database: with one configured, the room
# directory lives alongside the messages and nothing is written here.
DATA_DIR=./data


# ── Danger switches ──────────────────────────────────────────────────────

# Required by tools/tamper.js, which deliberately corrupts stored rows to
# demonstrate detection. Never set this on a deployed server.
# ALLOW_TAMPER=0
