# ─────────────────────────────────────────────────────────────────────────
# ChatFat — local environment
#
# Generated from .env.example. This file IS gitignored (unlike .env.example)
# so it's safe to hold real secrets. Fill in DATABASE_URL below.
# ─────────────────────────────────────────────────────────────────────────


# ── Network ──────────────────────────────────────────────────────────────

PORT=3000
HOST=0.0.0.0
ALLOWED_ORIGINS=

# Self-signed — browser will warn once, click through. Needed because
# WebCrypto (message signing) and Secure cookies both require an https://
# origin, and this host has no domain for a real certificate.
TLS_CERT_FILE=./tls-cert.pem
TLS_KEY_FILE=./tls-key.pem


# ── Database — P1 ────────────────────────────────────────────────────────
#
#   postgres://…  Durable. Paste the pooled Neon connection string here
#                 (host contains "-pooler"), keep ?sslmode=require.
#   memory        Everything works, held in this process, lost on restart.
#   (empty)       Refuses to start.
#
DATABASE_URL=postgresql://neondb_owner:npg_rAh45ObEUfdo@ep-muddy-dream-ay26a1ky-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require


# ── At-rest encryption — P4 (not yet read by the app — landing with req. 3) ─
#
# 32 random bytes, base64. Generated below so it's ready when the code that
# consumes it lands. Losing this makes all stored history unreadable, which
# is the intended failure mode — back it up somewhere that is not this repo
# once it's live.
MASTER_KEY=qpv2JKuKP/Ax0g+GEF2KJgQCO0g1Heaa5gcgje9l07E=
# MASTER_KEYS=


# ── Identity: Better Auth, email + password — P3 ─────────────────────────

BETTER_AUTH_SECRET=nTW6WarofrAz0dxC9EqmYpnVWzF44hw86xBReWF7F2Q=
BETTER_AUTH_URL=https://localhost:3000


# ── Messages ─────────────────────────────────────────────────────────────

HISTORY_REPLAY=50
HISTORY_CAP=200
MAX_ROOMS=24


# ── Encryption (end-to-end, per room) ────────────────────────────────────

ENCRYPTION_ENABLED=1
MAX_CIPHERTEXT=12288


# ── Storage ──────────────────────────────────────────────────────────────

DATA_DIR=./data


# ── Danger switches ──────────────────────────────────────────────────────

# Required by tools/tamper.js (not yet implemented — will land with req. 4),
# which deliberately corrupts stored rows to demonstrate detection. Never set
# this on a deployed server.
# ALLOW_TAMPER=0
