# tools/lab6.env.example — copy to tools/lab6.env and fill in.
#
# tools/lab6.env is gitignored. These values are secrets and the addresses of a
# private database; they must never reach the repository, which is public.

# The shared PostgreSQL on Sys1, addressed over the Docker bridge. Port 5432 is
# not published to the host, so the database is not reachable from outside.
DATABASE_URL='postgresql://chatfat:PASSWORD@172.17.0.74:5432/chatfat'

# 32 random bytes, base64. Encrypts message text at rest. All three backends
# MUST share the same key, or each will only be able to read what it wrote:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY='BASE64_32_BYTES'

# Connections per backend process. Three backends at this size must stay well
# under the server's max_connections (300).
DB_POOL_MAX=40

# Selection strategy and the switching threshold, in estimated ms to serve a
# request. 50 was chosen by tools/lab6-threshold-sweep.sh.
STRATEGY=p2c
LOAD_THRESHOLD=50
